# Which LLM answers questions. auto = Groq key > Anthropic key > OpenAI key > running Ollama > offline
LLM_PROVIDER=auto            # auto | ollama | groq | anthropic | openai | offline
# LLM_MODEL=                 # defaults: llama3.2 (ollama), llama-3.3-70b-versatile (groq),
                             #           claude-sonnet-5-5 (anthropic), gpt-4.1-mini (openai)

# Local and free: install Ollama, run `ollama pull llama3.2`, nothing else needed.
# OLLAMA_BASE_URL=http://localhost:11434

# Hosted and free (used by the live demo): https://console.groq.com/keys
GROQ_API_KEY=

# Paid, optional
ANTHROPIC_API_KEY=
OPENAI_API_KEY=              # also switches search to OpenAI embeddings

# Tuning (optional)
# RETRIEVER=auto             # auto | chroma | tfidf
# CHUNK_SIZE=800
# CHUNK_OVERLAP=120
# TOP_K=4
# CHROMA_DIR=.chroma
# MAX_QUESTIONS_PER_SESSION=20
